---
interface Props {
  about: {
    title: string;
    text: string;
    experience: string;
    vehicles_sold: string;
    happy_clients: string;
    rating: string;
  };
  primaryColor: string;
}

const { about, primaryColor } = Astro.props;
---

<section
  id="about"
  class="py-24 md:py-32 relative overflow-hidden"
  style={`background: linear-gradient(135deg, ${primaryColor}08 0%, white 50%, ${primaryColor}05 100%);`}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <!-- Text -->
      <div>
        <p
          class="text-sm uppercase tracking-[0.2em] font-semibold mb-4"
          style={`color: ${primaryColor};`}
          data-animate="fade-up"
        >
          Who We Are
        </p>
        <h2
          class="text-4xl md:text-5xl font-bold text-gray-900 mb-6"
          data-animate="fade-up"
          data-delay="0.1"
        >
          {about.title}
        </h2>
        <p
          class="text-lg text-gray-600 leading-relaxed mb-8"
          data-animate="fade-up"
          data-delay="0.2"
          data-highlight
        >
          {about.text}
        </p>
      </div>

      <!-- Stats -->
      <div class="grid grid-cols-2 gap-6" data-animate="fade-left">
        <div class="rounded-2xl p-6 text-center hover:shadow-lg transition-shadow duration-300 border"
          style={`background: ${primaryColor}08; border-color: ${primaryColor}15;`}>
          <p
            class="text-4xl font-bold mb-2"
            style={`color: ${primaryColor};`}
            data-counter={about.experience.replace('+', '')}
          >
            0
          </p>
          <p class="text-sm text-gray-500 uppercase tracking-wider">Years Experience</p>
        </div>
        <div class="rounded-2xl p-6 text-center hover:shadow-lg transition-shadow duration-300 border"
          style={`background: ${primaryColor}08; border-color: ${primaryColor}15;`}>
          <p
            class="text-4xl font-bold mb-2"
            style={`color: ${primaryColor};`}
            data-counter={about.vehicles_sold}
          >
            0
          </p>
          <p class="text-sm text-gray-500 uppercase tracking-wider">Vehicles Sold</p>
        </div>
        <div class="rounded-2xl p-6 text-center hover:shadow-lg transition-shadow duration-300 border"
          style={`background: ${primaryColor}08; border-color: ${primaryColor}15;`}>
          <p
            class="text-4xl font-bold mb-2"
            style={`color: ${primaryColor};`}
            data-counter={about.happy_clients}
          >
            0
          </p>
          <p class="text-sm text-gray-500 uppercase tracking-wider">Happy Clients</p>
        </div>
        <div class="rounded-2xl p-6 text-center hover:shadow-lg transition-shadow duration-300 border"
          style={`background: ${primaryColor}08; border-color: ${primaryColor}15;`}>
          <p
            class="text-4xl font-bold mb-2"
            style={`color: ${primaryColor};`}
            data-counter={about.rating}
          >
            0
          </p>
          <p class="text-sm text-gray-500 uppercase tracking-wider">Rating</p>
        </div>
      </div>
    </div>
  </div>
</section>
