---
interface Props {
  name: string;
  tagline: string;
  primaryColor: string;
  phone: string;
  ctaText?: string;
  ctaLink?: string;
  heroImage?: string;
}

const { name, tagline, primaryColor, phone, ctaText = "Explore Tours", ctaLink = "#packages", heroImage } = Astro.props;
---

<section
  data-hero
  id="home"
  class="relative h-screen flex items-center justify-center overflow-hidden"
>
  <!-- Background -->
  <div
    data-hero-bg
    class="absolute inset-0 z-0"
  >
    <!-- Dark overlay for text readability -->
    <div
      class="absolute inset-0 z-10"
      style={`background: linear-gradient(to bottom, ${primaryColor}33 0%, rgba(0,0,0,0.5) 40%, rgba(0,0,0,0.7) 100%);`}
    ></div>
    {heroImage ? (
      <img
        src={heroImage}
        alt=""
        class="absolute inset-0 w-full h-full object-cover"
      />
    ) : (
      <div
        class="absolute inset-0"
        style={`background: linear-gradient(135deg, ${primaryColor}88 0%, ${primaryColor}44 25%, #0F172A 55%, ${primaryColor}33 100%);`}
      ></div>
    )}
    <!-- Animated gradient orbs -->
    <div
      class="absolute top-1/4 left-1/6 w-[500px] h-[500px] rounded-full blur-3xl opacity-30 animate-pulse"
      style={`background: ${primaryColor};`}
    ></div>
    <div
      class="absolute bottom-1/3 right-1/4 w-[400px] h-[400px] rounded-full blur-3xl opacity-20 animate-pulse"
      style={`background: ${primaryColor}; animation-delay: 1s;`}
    ></div>
  </div>

  <!-- Content -->
  <div
    data-hero-content
    class="relative z-20 text-center max-w-4xl mx-auto px-6"
  >
    <p
      class="text-sm md:text-base uppercase tracking-[0.3em] mb-6 font-medium"
      style={`color: ${primaryColor};`}
    >
      Welcome to
    </p>
    <h1 class="text-5xl md:text-7xl lg:text-8xl font-bold text-white mb-6 leading-tight">
      {name}
    </h1>
    <p class="text-lg md:text-xl text-white/70 mb-10 max-w-2xl mx-auto leading-relaxed">
      {tagline}
    </p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4" data-cta>
      <a
        href={ctaLink}
        class="px-8 py-4 rounded-full text-white font-semibold text-lg transition-all duration-300 hover:scale-105 hover:shadow-lg"
        style={`background: ${primaryColor}; box-shadow: 0 0 30px ${primaryColor}44;`}
      >
        {ctaText}
      </a>
      <a
        href={`tel:${phone}`}
        class="px-8 py-4 rounded-full text-white font-semibold text-lg border-2 border-white/20 hover:border-white/50 transition-all duration-300 hover:scale-105"
      >
        Call Us
      </a>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-20 flex flex-col items-center gap-2">
    <span class="text-white/40 text-xs uppercase tracking-widest">Scroll</span>
    <div class="w-6 h-10 border-2 border-white/30 rounded-full flex justify-center pt-2">
      <div
        class="w-1.5 h-1.5 rounded-full animate-bounce"
        style={`background: ${primaryColor};`}
      ></div>
    </div>
  </div>
</section>

<!-- Scroll Progress Bar -->
<div class="scroll-progress">
  <div class="scroll-progress-bar" style={`background: ${primaryColor};`}></div>
</div>
