---
interface Props {
  about: {
    title: string;
    text: string;
    experience: string;
    tours_completed: string;
    happy_clients: string;
    rating: string;
  };
  primaryColor: string;
}

const { about, primaryColor } = Astro.props;
---

<section
  id="about"
  class="py-24 md:py-32 relative overflow-hidden"
  style={`background: linear-gradient(135deg, ${primaryColor}08 0%, white 50%, ${primaryColor}05 100%);`}
>
  <!-- Background decoration -->
  <div
    class="absolute top-0 right-0 w-96 h-96 rounded-full blur-3xl opacity-10"
    style={`background: ${primaryColor};`}
  ></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid md:grid-cols-2 gap-16 items-center">
      <!-- Text Side -->
      <div>
        <p
          class="text-sm uppercase tracking-[0.2em] font-semibold mb-4"
          style={`color: ${primaryColor};`}
          data-animate="fade-up"
        >
          Who We Are
        </p>
        <h2
          class="text-4xl md:text-5xl font-bold text-gray-900 mb-6 leading-tight"
          data-animate="fade-up"
          data-delay="0.1"
        >
          {about.title}
        </h2>
        <p
          class="text-lg text-gray-600 leading-relaxed mb-8"
          data-animate="fade-up"
          data-delay="0.2"
          data-highlight
        >
          {about.text}
        </p>
        <a
          href="#packages"
          class="inline-flex items-center gap-2 text-white px-6 py-3 rounded-full font-semibold transition-all duration-300 hover:scale-105"
          style={`background: ${primaryColor};`}
          data-animate="fade-up"
          data-delay="0.3"
        >
          View Our Tours
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <!-- Stats Side -->
      <div class="grid grid-cols-2 gap-6" data-stagger="0.15">
        <div
          class="rounded-2xl p-8 text-center hover:shadow-lg transition-shadow duration-300 border"
          style={`background: ${primaryColor}08; border-color: ${primaryColor}15;`}
        >
          <div
            class="text-4xl md:text-5xl font-bold mb-2"
            style={`color: ${primaryColor};`}
            data-counter={about.experience}
            data-suffix="+"
          >
            0+
          </div>
          <p class="text-gray-500 text-sm uppercase tracking-wider">Years Experience</p>
        </div>
        <div
          class="rounded-2xl p-8 text-center hover:shadow-lg transition-shadow duration-300 border"
          style={`background: ${primaryColor}08; border-color: ${primaryColor}15;`}
        >
          <div
            class="text-4xl md:text-5xl font-bold mb-2"
            style={`color: ${primaryColor};`}
            data-counter={about.tours_completed}
            data-suffix="+"
          >
            0+
          </div>
          <p class="text-gray-500 text-sm uppercase tracking-wider">Tours Completed</p>
        </div>
        <div
          class="rounded-2xl p-8 text-center hover:shadow-lg transition-shadow duration-300 border"
          style={`background: ${primaryColor}08; border-color: ${primaryColor}15;`}
        >
          <div
            class="text-4xl md:text-5xl font-bold mb-2"
            style={`color: ${primaryColor};`}
            data-counter={about.happy_clients}
            data-suffix="+"
          >
            0+
          </div>
          <p class="text-gray-500 text-sm uppercase tracking-wider">Happy Clients</p>
        </div>
        <div
          class="rounded-2xl p-8 text-center hover:shadow-lg transition-shadow duration-300 border"
          style={`background: ${primaryColor}08; border-color: ${primaryColor}15;`}
        >
          <div
            class="text-4xl md:text-5xl font-bold mb-2"
            style={`color: ${primaryColor};`}
          >
            {about.rating}
          </div>
          <p class="text-gray-500 text-sm uppercase tracking-wider">Star Rating</p>
        </div>
      </div>
    </div>
  </div>
</section>
