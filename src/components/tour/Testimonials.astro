---
interface Testimonial {
  name: string;
  location: string;
  text: string;
  rating: number;
}

interface Props {
  testimonials: Testimonial[];
  primaryColor: string;
}

const { testimonials, primaryColor } = Astro.props;
---

<section
  id="testimonials"
  class="py-24 md:py-32 relative overflow-hidden"
  style={`background: ${primaryColor}06;`}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-16">
      <p
        class="text-sm uppercase tracking-[0.2em] font-semibold mb-4"
        style={`color: ${primaryColor};`}
        data-animate="fade-up"
      >
        Testimonials
      </p>
      <h2
        class="text-4xl md:text-5xl font-bold text-gray-900 mb-4"
        data-animate="fade-up"
        data-delay="0.1"
      >
        What Our Guests Say
      </h2>
    </div>

    <!-- Testimonial Cards -->
    <div class="grid md:grid-cols-3 gap-8" data-stagger="0.15">
      {testimonials.map((t) => (
        <div class="bg-white rounded-2xl p-8 shadow-sm hover:shadow-xl transition-shadow duration-500 relative flex flex-col">
          <!-- Quote icon -->
          <div
            class="w-12 h-12 rounded-full flex items-center justify-center mb-6"
            style={`background: ${primaryColor}15;`}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-5 h-5"
              style={`color: ${primaryColor};`}
              fill="currentColor"
              viewBox="0 0 24 24"
            >
              <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
            </svg>
          </div>

          <!-- Stars -->
          <div class="flex gap-1 mb-4">
            {Array.from({ length: t.rating }).map(() => (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-5 h-5"
                style={`color: ${primaryColor};`}
                fill="currentColor"
                viewBox="0 0 24 24"
              >
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
              </svg>
            ))}
          </div>

          <!-- Text -->
          <p class="text-gray-600 leading-relaxed mb-6 italic">
            "{t.text}"
          </p>

          <!-- Author -->
          <div class="flex items-center gap-4 mt-auto">
            <div
              class="w-12 h-12 rounded-full flex items-center justify-center text-white font-bold text-lg"
              style={`background: ${primaryColor};`}
            >
              {t.name.charAt(0)}
            </div>
            <div>
              <p class="font-semibold text-gray-900">{t.name}</p>
              <p class="text-sm text-gray-400">{t.location}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
