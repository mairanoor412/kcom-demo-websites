---
import Navbar from "../components/common/Navbar.astro";
import Hero from "../components/common/Hero.astro";
import CarAbout from "../components/car-dealer/CarAbout.astro";
import FeaturedCars from "../components/car-dealer/FeaturedCars.astro";
import Services from "../components/car-dealer/Services.astro";
import WhyChooseUs from "../components/car-dealer/WhyChooseUs.astro";
import Testimonials from "../components/tour/Testimonials.astro";
import Contact from "../components/common/Contact.astro";
import Footer from "../components/common/Footer.astro";

interface Props {
  data: any;
}

const { data } = Astro.props;
const { colors } = data;

// Hero images for car dealers
const carHeroImages = [
  "/images/stock/cars/hero-1.jpg",
  "/images/stock/cars/hero-2.jpg",
  "/images/stock/cars/hero-3.jpg",
];
const heroIdx = data.name.length % carHeroImages.length;
const heroImage = data.heroImage || carHeroImages[heroIdx];

const navLinks = [
  { label: "Home", href: "#home" },
  { label: "About", href: "#about" },
  { label: "Inventory", href: "#inventory" },
  { label: "Services", href: "#services" },
  { label: "Contact", href: "#contact" },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={`${data.name} — ${data.tagline}. ${data.description}`} />
    <meta name="generator" content={Astro.generator} />
    <title>{data.name} — {data.tagline}</title>

    <style define:vars={{ primary: colors.primary, primaryDark: colors.primaryDark, secondary: colors.secondary, accent: colors.accent, light: colors.light }}>
      ::selection {
        background: var(--primary);
        color: white;
      }
    </style>
  </head>

  <body class="bg-white text-gray-900 overflow-x-hidden">
    <Navbar
      name={data.name}
      primaryColor={colors.primary}
      phone={data.phone}
      links={navLinks}
    />

    <Hero
      name={data.name}
      tagline={data.tagline}
      primaryColor={colors.primary}
      phone={data.phone}
      ctaText="View Inventory"
      ctaLink="#inventory"
      heroImage={heroImage}
    />

    <CarAbout
      about={data.about}
      primaryColor={colors.primary}
    />

    <FeaturedCars
      vehicles={data.featuredVehicles}
      primaryColor={colors.primary}
      phone={data.whatsapp}
    />

    <Services
      services={data.services}
      primaryColor={colors.primary}
    />

    <Testimonials
      testimonials={data.testimonials}
      primaryColor={colors.primary}
    />

    <WhyChooseUs
      usps={data.usps}
      primaryColor={colors.primary}
    />

    <Contact
      name={data.name}
      phone={data.phone}
      email={data.email}
      whatsapp={data.whatsapp}
      address={data.address}
      primaryColor={colors.primary}
      facebook={data.facebook}
      instagram={data.instagram}
    />

    <Footer
      name={data.name}
      primaryColor={colors.primary}
      phone={data.phone}
      email={data.email}
      address={data.address}
    />

    <!-- GSAP + Lenis + Animations -->
    <script>
      import { initSmoothScroll } from "../scripts/lenis-smooth-scroll.js";
      import { initAllAnimations } from "../scripts/gsap-animations.js";

      // Initialize immediately — Astro scripts are modules (deferred), so DOM is already ready
      initSmoothScroll();

      const primaryColor = getComputedStyle(document.documentElement)
        .getPropertyValue("--primary")
        .trim() || "#DC2626";

      initAllAnimations({ primaryColor });
    </script>

    <style>
      @import "../styles/global.css";
    </style>
  </body>
</html>
